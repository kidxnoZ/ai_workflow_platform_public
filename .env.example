# ============================================
# AI Workflow Platform — 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除）
# ============================================

# --- 存储与本地开发 ---
STORAGE_DIR=./storage
WHISPER_MODEL=small
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM（Agent 循环用）---
ANTHROPIC_BASE_URL=https://your-llm-endpoint.example
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=your-model-name

# --- TTS 服务（按实际启用的适配器填写）---
TTS_AUTH=your-tts-token
TTS_URL=https://your-tts-endpoint.example
AIGC_GATEWAY_URL=https://your-aigc-endpoint.example/v3/text/chat
MINIMAX_UPLOAD_URL=https://your-upload-endpoint.example/api/v2/tools/minimax/upload_file
MINIMAX_API_URL=https://your-minimax-endpoint.example
MINIMAX_API_KEY=your-minimax-key
MINIMAX_GATEWAY_AUTH=your-minimax-token
DOUBAO_GATEWAY_AUTH=your-doubao-token
DOUBAO_APPLY_URL=https://your-doubao-endpoint.example/api/v1/volcano/speakers/apply
DOUBAO_APPLY_APP_ID=your-app-id
DOUBAO_APPLY_PROJECT_ID=your-project-id
DOUBAO_USER=your-username

# --- Triton ASR 服务 ---
TRITON_SERVER=your-triton-host.example:8001

# --- 其他 TTS 厂商 ---
ELEVENLABS_API_KEY=your-elevenlabs-key
MIMO_API_KEY=your-mimo-key
DASHSCOPE_API_KEY=your-dashscope-key
